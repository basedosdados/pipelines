export GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
export VAULT_ADDRESS=https://vault.basedosdados.org/
export VAULT_TOKEN=<token>

# Local por padrão (o Prefect lê isso do .env sozinho, sem precisar
# exportar nada no shell — ver CONTRIBUTING.md, "Testar uma pipeline
# localmente"). Só aponte pro servidor real (https://prefect3.basedosdados.org/api,
# com PREFECT_API_KEY) pontualmente, na linha de comando, pra rodar
# `python -m pipelines.diagnostics health` — nunca deixe a URL real aqui.
export PREFECT_API_URL=http://127.0.0.1:4200/api
